# Nhost Configuration
# Get these values from your Nhost project dashboard at https://console.nhost.io

# Your Nhost subdomain (e.g., "abc123xyz")
VITE_NHOST_SUBDOMAIN=your-nhost-subdomain

# Your Nhost region (e.g., "us-east-1", "eu-west-1")
VITE_NHOST_REGION=us-east-1

# Optional: API URL (usually auto-constructed, only set if custom domain)
# VITE_NHOST_API_URL=https://your-nhost-url.nhost.run

# Authentication
# These are automatically handled by Nhost SDK
# Your app will use Nhost's built-in auth system

# Feature flags
VITE_ENABLE_CLOUD_SYNC=true
